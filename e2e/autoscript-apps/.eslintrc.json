{
  "extends": ["../../.eslintrc.json"],
  "ignorePatterns": ["!**/*", "**/*.png", "**/*.jpg", "**/*.svg", "**/dist/**"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@typescript-eslint/ban-ts-comment": "off",
        "@typescript-eslint/no-unused-vars": "warn",
        "prefer-const": "warn",
        "@typescript-eslint/no-explicit-any": "warn"
      }
    }
  ]
}
