{
  "name": "forgerock-javascript-sdk",
  "description": "ForgeRock JavaScript SDK",
  "engines": {
    "node": "^20 || ^18",
    "npm": ">= 7.0.0"
  },
  "private": true,
  "scripts": {
    "build": "nx affected --target=build",
    "clean": "shx rm -rf ./{coverage,dist,docs,node_modules,tmp}/ ./{packages,e2e}/*/{dist,node_modules}/ && git clean -fX -e \"!.env*,nx-cloud.env\"",
    "ci:release": "pnpm publish -r --no-git-checks && changeset tag",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm nx format:write --uncommitted",
    "changeset": "changeset",
    "commit": "git cz",
    "docs": "nx affected --target=typedoc",
    "e2e": "CI=true nx affected:e2e",
    "format:staged": "pretty-quick --staged",
    "lint": "nx affected --target=lint",
    "nx": "nx",
    "preinstall": "npx only-allow pnpm",
    "prepare": "node .husky/install.mjs",
    "publish:local": "node ./tools/release/local.mjs",
    "publish:dev": "node ./tools/release/dev.mjs",
    "start:token-vault": "nx run-many --target=serve --projects=token-vault-app,token-vault-proxy,mock-api",
    "test": "CI=true nx affected:test",
    "verdaccio": "nx local-registry",
    "commitlint": "commitlint --edit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ForgeRock/forgerock-javascript-sdk.git"
  },
  "author": "ForgeRock",
  "bugs": {
    "url": "https://github.com/ForgeRock/forgerock-javascript-sdk/issues"
  },
  "homepage": "https://github.com/ForgeRock/forgerock-javascript-sdk#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/prompt": "^20.0.0",
    "@effect/language-service": "^0.56.0",
    "@effect/platform": "^0.58.27",
    "@effect/platform-node": "^0.53.26",
    "@effect/schema": "^0.68.23",
    "@effect/vitest": "^0.27.0",
    "@nx/devkit": "22.1.0",
    "@nx/esbuild": "22.1.0",
    "@nx/eslint": "22.1.0",
    "@nx/eslint-plugin": "22.1.0",
    "@nx/express": "22.1.0",
    "@nx/js": "22.1.0",
    "@nx/node": "22.1.0",
    "@nx/playwright": "22.1.0",
    "@nx/vite": "22.1.0",
    "@nx/web": "22.1.0",
    "@nx/workspace": "22.1.0",
    "@playwright/test": "1.57.0",
    "@swc-node/register": "1.9.2",
    "@swc/core": "1.15.3",
    "@swc/helpers": "0.5.17",
    "@types/estree": "^1.0.8",
    "@types/express": "5.0.5",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "@typescript-eslint/typescript-estree": "5.59.5",
    "@typescript-eslint/utils": "^8.13.0",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "@vitest/coverage-v8": "^4.0.14",
    "@vitest/ui": "^4.0.14",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cz-conventional-changelog": "^3.3.0",
    "cz-git": "^1.12.0",
    "effect": "^3.5.3",
    "effect-http": "^0.73.0",
    "effect-http-node": "^0.16.1",
    "esbuild": "^0.19.2",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-playwright": "^1.5.1",
    "eslint-plugin-prettier": "^5.1.3",
    "express": "5.1.0",
    "fast-check": "^4.3.0",
    "husky": "^9.1.7",
    "jiti": "2.6.1",
    "jsdom": "27.2.0",
    "jsonc-eslint-parser": "^2.4.1",
    "lint-staged": "^16.2.7",
    "mkcert": "^3.2.0",
    "npm-cli-login": "^1.0.0",
    "nx": "22.1.0",
    "pkg-pr-new": "^0.0.60",
    "playwright": "1.57.0",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0",
    "sass": "^1.94.2",
    "shx": "^0.4.0",
    "superagent": "^10.2.3",
    "swc-loader": "0.2.6",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.27.4",
    "typedoc-github-theme": "0.2.0",
    "typedoc-plugin-rename-defaults": "^0.7.2",
    "typescript": "5.9.3",
    "uuid": "^13.0.0",
    "verdaccio": "6.2.1",
    "vite": "7.2.4",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-externalize-deps": "^0.8.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.14",
    "vitest-canvas-mock": "^1.1.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "nx": {
    "includedScripts": []
  },
  "packageManager": "pnpm@9.15.0+sha256.09a8fe31a34fda706354680619f4002f4ccef6dadff93240d24ef6c831f0fd28",
  "dependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9"
  },
  "pnpm": {
    "overrides": {}
  }
}
