{
  "extends": ["../../.eslintrc.json"],
  "overrides": [
    {
      "files": ["*.ts", "*.js"]
    },
    {
      "files": ["*.json"],
      "parser": "jsonc-eslint-parser",
      "rules": {
        "@nx/dependency-checks": [
          "warn",
          {
            "ignoredFiles": [
              "{projectRoot}/eslint.config.{js,cjs,mjs}",
              "{projectRoot}/vite.config.{js,ts,mjs,mts}"
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/vite.config.*.timestamp*",
    "**/vitest.config.*.timestamp*"
  ]
}
